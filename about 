* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #111;
    color: white;
}

#skills {
    padding: 60px 20px;
    text-align: center;
}

#skills h2 {
    font-size: 40px;
    margin-bottom: 40px;
    color: #00d9ff;
}

.skills-container {
    max-width: 700px;
    margin: auto;
}

.skill-card {
    margin-bottom: 25px;
    text-align: left;
}

.skill-card h3 {
    margin-bottom: 8px;
}

.bar {
    width: 100%;
    background: #333;
    border-radius: 20px;
    overflow: hidden;
}

.progress {
    height: 25px;
    line-height: 25px;
    color: white;
    text-align: center;
    font-weight: bold;
    border-radius: 20px;
}

.html {
    width: 90%;
    background: #ff5733;
}

.css {
    width: 85%;
    background: #2196f3;
}

.js {
    width: 75%;
    background: #f7df1e;
    color: black;
}

.python {
    width: 80%;
    background: #4caf50;
}